# Copy to .env for local development.
# eBay production keyset (developer.ebay.com > Application Keys > Production): App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# mock: built-in sample listings instead of eBay. mock agent: canned replies instead of Claude.
# SCOUR_EBAY=mock
# SCOUR_AGENT=mock
# Locally the agent uses your `claude` login. The server uses a `claude setup-token` token:
# CLAUDE_CODE_OAUTH_TOKEN=
